# Supabase Postgres connection string (Project Settings → Database)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the deployed site (used for SEO + absolute links). No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: only needed in production if you want uploaded media stored on Vercel Blob
# instead of the local filesystem (required on Vercel, since the filesystem is ephemeral).
# Create a Blob store in your Vercel project settings to get this token.
BLOB_READ_WRITE_TOKEN=
